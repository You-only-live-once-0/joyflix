# Site login
USERNAME=admin
PASSWORD=change-me

# Use independent long random secrets in production.
# Example: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret

# Storage: localstorage | upstash | redis
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# Upstash (required when NEXT_PUBLIC_STORAGE_TYPE=upstash)
# UPSTASH_URL=https://...
# UPSTASH_TOKEN=...
